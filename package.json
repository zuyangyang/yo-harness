{
  "name": "yo-harness",
  "version": "0.1.0",
  "description": "yo-harness — 本地优先的个人智能体 harness（CLI）",
  "type": "module",
  "bin": {
    "yo": "dist/main.js"
  },
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests examples --no-error-on-unmatched-pattern",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "keywords": [
    "agent",
    "harness",
    "cli",
    "llm"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "ink": "^5.2.1",
    "ink-text-input": "^6.0.0",
    "openai": "^7.23.0",
    "picocolors": "^1.1.1",
    "react": "^18.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.6",
    "@types/react": "^18.3.31",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
