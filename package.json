{
  "name": "yo-harness",
  "version": "0.1.0",
  "description": "yo-harness — 本地优先的个人智能体 harness（monorepo）",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "dev": "pnpm --filter @yo-harness/cli run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "lint": "eslint packages/*/src packages/*/tests --no-error-on-unmatched-pattern",
    "format": "prettier --write .",
    "test": "pnpm -r run test",
    "test:watch": "pnpm -r run test:watch"
  },
  "keywords": [
    "agent",
    "harness",
    "cli",
    "llm"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
