# yo-harness 环境变量样例（复制为 .env 后填写）
# 也可用 ~/.yo-harness/config.json 的 apiKeyEnv 字段指定其他变量名
#
# 说明：这里填写的 provider 密钥只从环境读取、不进日志；
# Web UI（设置 → 模型）里填写的密钥会加密落库（AES-256-GCM），
# 且优先级高于 .env（见 docs/MODEL-CONFIG-DESIGN.md）。

# ---- 模型 Provider（二选一或都用）----
# Anthropic（https://console.anthropic.com）
ANTHROPIC_API_KEY=

# OpenAI 兼容：DeepSeek / 豆包 Ark / Kimi / OpenRouter 等
# baseURL 在 ~/.yo-harness/config.json 的 providers.openai-compat.baseURL 配置
OPENAI_COMPAT_API_KEY=

# ---- 网络搜索（在 ~/.yo-harness/config.json 的 search.provider 选择）----
# Tavily（https://tavily.com，有免费额度）
TAVILY_API_KEY=
# 博查 Bocha（https://open.bochaai.com，国内直连）
BOCHA_API_KEY=
# Serper（https://serper.dev）
SERPER_API_KEY=

# ---- yo-harness 覆盖项（可选）----
# 数据目录（默认 ~/.yo-harness）
# YO_DATA_DIR=
# 覆盖默认 provider：anthropic | openai-compat
# YO_PROVIDER=
# 覆盖所选 provider 的默认模型
# YO_MODEL=
# 日志级别：debug | info | warn | error
# YO_LOG=info

# ---- Web UI 模型配置的主密钥（可选）----
# 用于加密 Web UI 中保存的 provider API 密钥（AES-256-GCM）。
# 未设置时会在 ~/.yo-harness/secret.key 自动生成（权限 0600）。
# 生成方式：openssl rand -hex 32
# 注意：丢失该密钥会导致已保存的 API 密钥无法解密，需要重新录入。
# YO_SECRET_KEY=
