{
  "name": "@yo-harness/server",
  "version": "0.1.0",
  "description": "yo-harness headless server（HTTP + WebSocket）",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/node-ws": "^1.3.1",
    "@types/ws": "^8.18.1",
    "@yo-harness/core": "workspace:*",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.13.10",
    "jose": "^6.0.11",
    "pg": "^8.16.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/pg": "^8.15.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
